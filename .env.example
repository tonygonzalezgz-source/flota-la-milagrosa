# ══════════════════════════════════════════════════
#  LA MILAGROSA — Variables de Entorno
#  Copia este archivo como ".env" y completa los valores
# ══════════════════════════════════════════════════

# ── BASE DE DATOS ──
# Sin esta variable → usa SQLite local (desarrollo)
# Con esta variable → usa Supabase PostgreSQL (producción)
#
# Obtén la URL en: Supabase → Settings → Database → Connection string → URI
# Reemplaza [TU-PASSWORD] con la contraseña de tu proyecto
#
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres

# ── SERVIDOR ──
# Puerto del API Flask (por defecto 8001)
PORT=8001

# ── SEGURIDAD ──
# Clave secreta para firmar tokens JWT (¡CAMBIAR en producción!)
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-segura

# Horas de validez del token JWT (por defecto 12)
JWT_EXPIRY_HOURS=12

# Orígenes permitidos para CORS (en producción usar tu dominio exacto)
# Ejemplo: https://tu-app.onrender.com
ALLOWED_ORIGINS=*

# ── CHATBOT CON IA (Fase 1) ──
# Habilita el drawer del chatbot en la UI. Off por defecto.
FEATURE_CHATBOT=false

# Proveedor de LLM: "anthropic" (Claude) o "google" (Gemini).
AI_PROVIDER=google

# Credenciales (solo se necesita la del proveedor elegido en AI_PROVIDER).
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Overrides opcionales de modelo (si se omiten, se usan estos valores):
# ANTHROPIC_MODEL=claude-sonnet-5
# GOOGLE_MODEL=gemini-3.5-flash

# Respaldos de Gemini: si el modelo principal responde 503 (saturado), el chat
# reintenta y luego pasa al siguiente de esta lista. Vacío = sin respaldos.
# GOOGLE_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite

# Intentos por modelo antes de pasar al siguiente (con espera creciente).
# GOOGLE_ATTEMPTS_PER_MODEL=2
